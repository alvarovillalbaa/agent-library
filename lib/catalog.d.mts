export type Kind = 'skill' | 'mcp' | 'subagent' | 'command';
export type SubmissionKind = Exclude<Kind, 'mcp'>;
export type Area = 'Engineering' | 'Product' | 'Design' | 'Marketing' | 'Sales' | 'Finance' | 'People' | 'Operations';
export type SourceFile = { path: string; content: string };
export type Submission = { kind: SubmissionKind; title: string; summary: string; area: Area; owner: string; repository?: string; license: string; files: SourceFile[] };
export type ReviewCheck = { id: string; title: string; passed: boolean; issue: string; fix: string };
export type ReviewResult = { status: 'approved' | 'changes_requested' | 'invalid' | 'unavailable' | 'rate_limited'; summary: string; checks: ReviewCheck[]; repairPrompt: string; entrySlug?: string };
export type Entry = { _id: string; slug: string; kind: Kind; title: string; summary: string; area: Area; owner: string; repository?: string; sourceUrl?: string; license: string; files: SourceFile[]; overview: string; bestFor: string[]; considerations: string[]; review: { method: string; model?: string; version: string; reviewedAt: number }; publishedAt: number };
export type EntrySummary = Omit<Entry, 'files'>;
export type CatalogResult = { entries: EntrySummary[]; owners: string[]; counts: Record<Kind, number>; truncated: boolean };
export const KINDS: readonly Kind[];
export const AREAS: readonly Area[];
export const KIND_LABELS: Readonly<Record<Kind, string>>;
export const LIMITS: Readonly<{ files: number; fileBytes: number; totalBytes: number; title: number; summary: number; reviewPerHour: number }>;
export const REVIEW_CHECKS: readonly { id: string; title: string }[];
export function normalizeUploadFiles(files: SourceFile[]): SourceFile[];
export function validateSubmission(raw: unknown): { ok: boolean; errors: string[]; submission?: Submission };
export function makeInstallCommand(repository?: string): string | null;
export function makeRepairPrompt(submission: Submission, checks: ReviewCheck[]): string;
