# Browser-visible Convex deployment URL, never a deploy key.
VITE_CONVEX_URL=

# Server-only scoped production key for the hosted build's Convex deployment.
CONVEX_DEPLOY_KEY=

# Server-only shared secret for the authenticated Convex-to-Vercel model relay.
REVIEW_RELAY_SECRET=

# Review settings belong in Convex environment variables, not VITE_ variables.
# REVIEW_RELAY_URL, REVIEW_RELAY_SECRET and REVIEW_MODEL are set in Convex.
# See docs/operations.md. No account-wide credential belongs in this project.
